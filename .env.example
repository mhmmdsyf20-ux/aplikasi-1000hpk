# .env.example — Template konfigurasi aplikasi 1000 HPK
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository!

# ── Keamanan ──────────────────────────────────────────────────────────────────
# Gunakan string acak minimal 32 karakter. Contoh generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# ── Database (PostgreSQL untuk PythonAnywhere gratis) ─────────────────────────
DB_TYPE=postgresql
DB_HOST=muhammadsyafii08-1234.postgres.pythonanywhere-services.com
DB_PORT=14390
DB_USER=muhammadsyafii08
DB_PASSWORD=password_postgres_anda
DB_NAME=muhammadsyafii08

# Atau gunakan DATABASE_URL langsung (opsional, override semua setting DB di atas):
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname

# ── WhatsApp Gateway ───────────────────────────────────────────────────────────
# Pilihan: "fonnte" (default, lokal Indonesia) atau "twilio"
WA_GATEWAY=fonnte

# Untuk Fonnte (https://fonnte.com):
WA_API_KEY=api_key_fonnte_anda
WA_SENDER=nomor_wa_pengirim_fonnte

# Untuk Twilio WhatsApp API (https://www.twilio.com):
# WA_API_KEY=account_sid:auth_token
# WA_SENDER=whatsapp:+14155238886

# ── Identitas Fasilitas ────────────────────────────────────────────────────────
NAMA_FASILITAS=Puskesmas Terdekat
