body {
    font-family: Arial;
    background: #eef;
    text-align: center;
}

a {
    display: inline-block;
    margin: 10px;
    padding: 10px;
    background: blue;
    color: white;
    text-decoration: none;
}

table {
    margin: auto;
    border-collapse: collapse;
}

td, th {
    border: 1px solid black;
    padding: 10px;
}